{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["username", "email", "userId"],
      "$userId": {
        ".write": "auth != null && (auth.uid === $userId || !data.exists())"
      }
    },
    "user_chats": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null",
        ".indexOn": ["lastMessageTimestamp"]
      }
    },
    "user_calls": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null"
      }
    },
    "user_chat_locks": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (data.child('participants/' + auth.uid).val() === true || root.child('user_chats/' + auth.uid + '/' + $chatId).exists())",
        ".write": "auth != null && (!data.exists() || data.child('participants/' + auth.uid).val() === true || root.child('user_chats/' + auth.uid + '/' + $chatId).exists() || newData.child('participants/' + auth.uid).val() === true)",
        "messages": {
          ".read": "auth != null && (root.child('chats/' + $chatId + '/participants/' + auth.uid).val() === true || root.child('user_chats/' + auth.uid + '/' + $chatId).exists())",
          ".write": "auth != null && (root.child('chats/' + $chatId + '/participants/' + auth.uid).val() === true || root.child('user_chats/' + auth.uid + '/' + $chatId).exists())",
          ".indexOn": ["timestamp", "senderId", "seen", "type"]
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt", "isStreaming", "status", "roomId", "genre", "nameLower", "isScheduled"],
      "$roomId": {
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp", "senderId"]
        },
        "reactions": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp"]
        }
      }
    },
    "rooms_playback": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || root.child('rooms/' + $roomId + '/creator/uid').val() === auth.uid || root.child('rooms/' + $roomId + '/creator/userId').val() === auth.uid || root.child('rooms/' + $roomId + '/coHosts/' + auth.uid).exists())"
      }
    },
    "user_rooms": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null",
        ".indexOn": ["createdAt"]
      }
    },
    "room_presence": {
      "$roomId": {
        ".read": "auth != null",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },
    "media_blobs": {
      ".read": "auth != null",
      ".indexOn": ["senderId", "createdAt"],
      "$mediaId": {
        ".write": "auth != null"
      }
    },
    "media_relay": {
      ".read": "auth != null",
      ".indexOn": ["senderId", "createdAt"],
      "$mediaId": {
        ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid || !newData.exists())"
      }
    },
    "friends": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null",
        ".indexOn": [".value"]
      }
    },
    "friend_requests": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null"
      }
    },
    "user_friend_requests": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null"
      }
    },
    "watchlist": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "notes": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$key1": {
        "$key2": {
          ".indexOn": ["timestamp", "seconds"]
        }
      }
    }
  }
}
