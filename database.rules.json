{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["username", "email", "userId"],
      "$userId": {
        ".write": "auth != null && (auth.uid === $userId || !data.exists())"
      }
    },
    "user_chats": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null",
        ".indexOn": ["lastMessageTimestamp"]
      }
    },
    "user_calls": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp", "senderId", "seen", "type"]
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt", "isStreaming", "status", "roomId", "genre", "nameLower", "isScheduled"],
      "$roomId": {
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp", "senderId"]
        },
        "reactions": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": ["timestamp"]
        }
      }
    },
    "user_rooms": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null",
        ".indexOn": ["createdAt"]
      }
    },
    "room_presence": {
      "$roomId": {
        ".read": "auth != null",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },
    "media_blobs": {
      ".read": "auth != null",
      ".indexOn": ["senderId", "createdAt"],
      "$mediaId": {
        ".write": "auth != null"
      }
    },
    "friends": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null",
        ".indexOn": [".value"]
      }
    },
    "notes": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$key1": {
        "$key2": {
          ".indexOn": ["timestamp", "seconds"]
        }
      }
    }
  }
}
